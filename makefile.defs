$(shell $(CROSS_COMPILE)gcc  -E -dM -P ../app_src/system_config/sys_em_config.h > sys_em.cfg)
   
BT_LIB1 := $(shell grep -o 'USE_BT_STD_LIB' sys_em.cfg)
BT_LIB2 := $(shell grep -o 'USE_BT_BIS_LIB' sys_em.cfg)
BT_LIB3 := $(shell grep -o 'USE_BT_TWS_LIB' sys_em.cfg)
BT_LIB4 := $(shell grep -o 'USE_BT_TWS_NO_BLE_LIB' sys_em.cfg)
BT_LIB5 := $(shell grep -o 'USE_BT_BIS_TWS_LIB' sys_em.cfg)
BT_LIB6 := $(shell grep -o 'USE_BT_NO_BLE_LIB' sys_em.cfg)
BT_LIB7 := $(shell grep -o 'USE_BLE_LIB' sys_em.cfg)
BT_LIB8 := $(shell grep -o 'USE_BT_CIS_LIB' sys_em.cfg)

ifeq ($(BT_LIB1),USE_BT_STD_LIB)
$(info [BT LIB] Copying libBtStack_Std.a -> libBtStack.a)
$(shell cp -f ../middleware/bluetooth/libBtStack_Std.a ../middleware/bluetooth/libBtStack.a)
else ifeq ($(BT_LIB2),USE_BT_BIS_LIB)
$(info [BT LIB] Copying libBtStack_Bis.a -> libBtStack.a)
$(shell cp -f ../middleware/bluetooth/libBtStack_Bis.a ../middleware/bluetooth/libBtStack.a)
else ifeq ($(BT_LIB3),USE_BT_TWS_LIB)
$(info [BT LIB] Copying libBtStack_Tws.a -> libBtStack.a)
$(shell cp -f ../middleware/bluetooth/libBtStack_Tws.a ../middleware/bluetooth/libBtStack.a)
else ifeq ($(BT_LIB4),USE_BT_TWS_NO_BLE_LIB)
$(info [BT LIB] Copying libBtStack_Tws_NoBle.a -> libBtStack.a)
$(shell cp -f ../middleware/bluetooth/libBtStack_Tws_NoBle.a ../middleware/bluetooth/libBtStack.a)
else ifeq ($(BT_LIB5),USE_BT_BIS_TWS_LIB)
$(info [BT LIB] Copying libBtStack_BisAndTws.a -> libBtStack.a)
$(shell cp -f ../middleware/bluetooth/libBtStack_BisAndTws.a ../middleware/bluetooth/libBtStack.a)
else ifeq ($(BT_LIB6),USE_BT_NO_BLE_LIB)
$(info [BT LIB] Copying libBtStack_noBle.a -> libBtStack.a)
$(shell cp -f ../middleware/bluetooth/libBtStack_noBle.a ../middleware/bluetooth/libBtStack.a)
else ifeq ($(BT_LIB7),USE_BLE_LIB)
$(info [BT LIB] Copying libBtStack_Ble.a -> libBtStack.a)
$(shell cp -f ../middleware/bluetooth/libBtStack_Ble.a ../middleware/bluetooth/libBtStack.a)
else ifeq ($(BT_LIB8),USE_BT_CIS_LIB)
$(info [BT LIB] Copying libBtStack_Cis.a -> libBtStack.a)
$(shell cp -f ../middleware/bluetooth/libBtStack_Cis.a ../middleware/bluetooth/libBtStack.a)

endif
